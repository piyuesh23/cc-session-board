# Copy to .env on the Pi.

# Shared with the hook (CC_BOARD_SECRET on the devbox). Generate one with:
#   openssl rand -hex 24
BOARD_SECRET=change-me

# Optional. Lets the board page answer permission prompts & questions: pair the
# phone with it once. It can only list & answer prompts, nothing else. Use a
# different value from BOARD_SECRET. Leave empty to keep the board read-only.
APPROVE_SECRET=

PORT=8787
# Bind to the Pi's Tailscale IP so the hub is not reachable from the home LAN.
# "tailscale" looks it up with `tailscale ip -4` at startup.
HOST=tailscale

# Minutes with no events before a tile goes grey, & before it is dropped.
STALE_MIN=10
HIDE_MIN=60

# A blocked tile ignores those two, but is dropped after this many hours of
# silence (a laptop that crashed or slept mid-prompt never sends session_end).
BLOCKED_MAX_H=24

# No chime & a dimmed screen in this window (the iPhone's local time).
QUIET_HOURS=23:00-07:00
